# ---- MongoDB Atlas ----
# Connection string do seu cluster Atlas. NUNCA versione o valor real.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Nome do banco (default no codigo: legal_assistant)
MONGODB_DB=legal_assistant

# ---- LLM (endpoint compativel com OpenAI Chat Completions) ----
LLM_API_URL=https://<seu-endpoint>/v1/chat/completions
LLM_API_KEY=<sua-api-key>
LLM_MODEL=gpt-4o-mini

# ---- Opcionais ----
RAG_USE_CHUNKS=true
CACHE_HIT_THRESHOLD=0.80
MEMORY_COLLECTION=agent_memory
